{
  "name": "console-log",
  "displayName": "Console Log",
  "icon": "icon.png",
  "description": "快速插入 console.log",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Snippets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lhf6623/console-log.git"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:html",
    "onLanguage:svelte"
  ],
  "main": "./dist/extension.js",
  "dependencies": {},
  "contributes": {
    "commands": [
      {
        "command": "console-log.insertLog",
        "title": "Insert Console.log"
      }
    ],
    "keybindings": [
      {
        "command": "console-log.insertLog",
        "key": "Ctrl+Alt+L",
        "mac": "Ctrl+Alt+L"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && pnpm run format:check && node esbuild.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "~22.20.1",
    "@types/vscode": "^1.74.0",
    "acorn": "^8.18.0",
    "acorn-typescript": "^1.4.13",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
